# ==========================================================
#  爆点逃跑 · 环境变量示例
#  复制为 .env 后按需修改。⚠️ .env 含凭据，绝不要提交到 Git。
# ==========================================================

# ---------- Discord 应用 ----------
# https://discord.com/developers/applications 里的 Application ID
DISCORD_CLIENT_ID=
# Client Secret（OAuth2 → General Information）
DISCORD_CLIENT_SECRET=
# Bot Token（Bot → Token）
DISCORD_BOT_TOKEN=

# OAuth2 回调地址，必须与 Discord 后台填的【完全一致】。
# 正式部署用公网地址；本地调试会在 /auth/login 生成，会覆盖成 127.0.0.1。
DISCORD_REDIRECT_URI=https://your-domain.example.com/auth/callback

# 站点根地址。https:// 开头会自动启用 SameSite=None; Secure; Partitioned
# （Discord 小活动的跨站 iframe 必须，Safari/iOS 会直接拒收没带 Partitioned 的 Cookie）
APP_URL=https://your-domain.example.com

# ---------- 后台管理员 ----------
# Discord ID 白名单，逗号分隔。决定谁能进 /admin
ADMIN_DISCORD_IDS=

# ---------- 端口与数据库 ----------
HTTP_PORT=8080
WS_PORT=9501
# 相对 server/ 的上级目录，即 <repo>/../data/baodian.db
DB_FILE=data/baodian.db

# ---------- 金币奖励 ----------
# 首次登录赠送
INITIAL_COINS=1000
# 每日签到
CHECKIN_COINS=100
# 邀请人奖励（对方需完成 min_rounds 局）
INVITE_REWARD_COINS=1000
INVITE_MIN_ROUNDS=3
# 被邀请人奖励（仅存在有效邀请关系时发放）
INVITE_NEWCOMER_COINS=1000

# ---------- Discord 频道联动（可选） ----------
# 每日高倍活动的 Guild 与频道。不填则只发站内，不发 Discord
BOT_GUILD_ID=
DISCORD_EVENT_CHANNEL_ID=

# ---------- 其它 ----------
# 强制启用 Secure Cookie（一般由 APP_URL 自动推断，本地 http 调试时不要开）
COOKIE_SECURE=
# 本地调试开关：允许 127.0.0.1 调用 /api/auth/dev-login，【生产务必留空】
DEV_LOGIN=
